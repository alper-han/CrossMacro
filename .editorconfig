# Editor defaults
root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_diagnostic.MA0127.severity = none

# Naming
dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.methods_should_be_pascal_case.severity = warning
dotnet_naming_rule.methods_should_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.fields_should_be_camel_case.severity = warning
dotnet_naming_rule.fields_should_be_camel_case.symbols = non_private_fields
dotnet_naming_rule.fields_should_be_camel_case.style = camel_case_style
dotnet_naming_rule.private_fields_should_be_camel_case_underscore.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case_underscore.style = camel_case_underscore_style
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_style.required_prefix = _

# .NET style
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_member_parameters = true:warning
dotnet_style_predefined_type_for_locals_parameters = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_parentheses_in_arithmetic_binary_operators = always_if_unnecessary:warning
dotnet_style_parentheses_in_relational_binary_operators = always_if_unnecessary:warning
dotnet_style_parentheses_in_other_binary_operators = always_if_unnecessary:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:warning
csharp_style_unused_value_assignment_preference = discard_variable:warning

# C# style
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_prefer_braces = true:warning
csharp_prefer_simple_default_expression = true:warning
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_prefer_simple_using_statement = true:warning
csharp_style_prefer_local_over_anonymous_function = true:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_static_lambda_function = true:warning
csharp_prefer_static_local_function = true:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = no_change
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_cases_from_switch = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# IDE diagnostics
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0072.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning

# Modern C# rules
dotnet_diagnostic.IDE0230.severity = warning
dotnet_diagnostic.IDE0290.severity = warning
dotnet_diagnostic.IDE0330.severity = warning
dotnet_diagnostic.IDE0360.severity = warning

# Performance rules
dotnet_diagnostic.CA1854.severity = warning
dotnet_diagnostic.CA1855.severity = warning
dotnet_diagnostic.CA1862.severity = warning
dotnet_diagnostic.CA1863.severity = warning
dotnet_diagnostic.CA1864.severity = warning
dotnet_diagnostic.CA1865.severity = warning
dotnet_diagnostic.CA1866.severity = warning
dotnet_diagnostic.CA1867.severity = warning
dotnet_diagnostic.CA1868.severity = warning
dotnet_diagnostic.CA1869.severity = warning
dotnet_diagnostic.CA1870.severity = warning
dotnet_diagnostic.CA1871.severity = warning
dotnet_diagnostic.CA1872.severity = warning
dotnet_diagnostic.CA1873.severity = warning
dotnet_diagnostic.CA1874.severity = warning
dotnet_diagnostic.CA1875.severity = warning
dotnet_diagnostic.CA1857.severity = warning
dotnet_diagnostic.CA2024.severity = warning
dotnet_diagnostic.CA2259.severity = warning
dotnet_diagnostic.CA2260.severity = warning
dotnet_diagnostic.CA2263.severity = warning
dotnet_diagnostic.IDE0320.severity = suggestion

# Security rules
dotnet_diagnostic.S3011.severity = warning
dotnet_diagnostic.S4423.severity = warning
dotnet_diagnostic.S5766.severity = warning
dotnet_diagnostic.MA0138.severity = warning
dotnet_diagnostic.MA0155.severity = warning
dotnet_diagnostic.MA0161.severity = warning
dotnet_diagnostic.MA0162.severity = warning

# Analyzer suppressions
# Use the maintained .NET/IDE/Sonar equivalents for these overlapping Meziantou rules.
dotnet_diagnostic.MA0010.severity = none
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0022.severity = none
dotnet_diagnostic.MA0033.severity = none
dotnet_diagnostic.MA0214.severity = none
dotnet_diagnostic.MA0215.severity = none
dotnet_diagnostic.MA0217.severity = none
dotnet_diagnostic.MA0222.severity = none
dotnet_diagnostic.MA0223.severity = none
dotnet_diagnostic.MA0224.severity = none
dotnet_diagnostic.MA0225.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0040.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0158.severity = none
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0058.severity = warning
dotnet_diagnostic.S2292.severity = none
dotnet_diagnostic.MA0046.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.RCS1210.severity = none
dotnet_diagnostic.RCS1102.severity = none
dotnet_diagnostic.RCS1194.severity = none
dotnet_diagnostic.S3881.severity = none
dotnet_diagnostic.S3993.severity = none
# CA2016 is the canonical CancellationToken-forwarding rule for this repository.
dotnet_diagnostic.S8949.severity = none
dotnet_diagnostic.MA0174.severity = none
dotnet_diagnostic.RCS1037.severity = none

# MA0181: native casts are required for interop, pointer arithmetic, and marshaling.
dotnet_diagnostic.MA0181.severity = none

# Generated files
[*.g.cs]
generated_code = true
[*.Designer.cs]
generated_code = true
[*/{bin,obj}/**]
generated_code = true

# WindowInfo preserves the -1 unknown-process contract.
[src/CrossMacro.Platform.Abstractions/WindowManagement/WindowInfo.cs]
dotnet_diagnostic.IDE0032.severity = none

# Native interop naming and layout
[src/**/Native/**/*.cs]
dotnet_diagnostic.S101.severity = none
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1815.severity = none
dotnet_diagnostic.CA1401.severity = none
dotnet_diagnostic.S4200.severity = none

# XKB layout codes remain lowercase for libxkbcommon and DBus callers.
[src/CrossMacro.Platform.Linux/Services/Keyboard/XkbLayoutNameResolver.cs]
dotnet_diagnostic.CA1308.severity = none

# Global exceptions: CA2213 cannot distinguish DI-borrowed services and async leases from
# owned fields; the remaining rules conflict with the field naming convention, SafeHandle-based
# cleanup, public abstraction boundaries, or platform-specific process/native-library resolution.
[*]
dotnet_diagnostic.CA2213.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2216.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.S2325.severity = none
dotnet_diagnostic.MA0045.severity = suggestion
dotnet_diagnostic.MA0042.severity = suggestion
dotnet_diagnostic.MA0051.severity = suggestion
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.S127.severity = suggestion
dotnet_diagnostic.CA1003.severity = suggestion

# S4036: PATH lookup is required for cross-distro Linux portability.
dotnet_diagnostic.S4036.severity = none

# CA2007: UI awaits resume on the dispatcher, so retain it as editor guidance there.
[src/CrossMacro.UI/**.cs]
dotnet_diagnostic.CA2007.severity = suggestion
[src/CrossMacro.UI.{Linux,Windows,MacOS}/**.cs]
dotnet_diagnostic.CA2007.severity = suggestion

# xUnit owns test synchronization-context and async-void guidance.
[tests/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0155.severity = none
# xUnit collection definitions must remain public and conventionally end in Collection.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1711.severity = none
# Test doubles and awaited harness tasks make these rules produce test-only false positives.
# Retain editor feedback without turning intentional test mechanics into build noise.
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA2012.severity = suggestion
dotnet_diagnostic.CA2025.severity = suggestion
dotnet_diagnostic.MA0109.severity = suggestion
# Timeout attributes also fence synchronous or intentionally non-cancelable system-boundary tests.
# Keep xUnit's cooperative-cancellation reminder in the editor without requiring fake token consumption.
dotnet_diagnostic.xUnit1069.severity = suggestion

# Test doubles and source-boundary tests deliberately use these patterns.
# Keep them visible in the editor without letting test-only conventions obscure lifecycle diagnostics in builds.
dotnet_diagnostic.MA0136.severity = suggestion
dotnet_diagnostic.MA0191.severity = suggestion
dotnet_diagnostic.CA1812.severity = suggestion
dotnet_diagnostic.CA1849.severity = suggestion
dotnet_diagnostic.S6966.severity = suggestion
dotnet_diagnostic.S108.severity = suggestion
dotnet_diagnostic.IDE0048.severity = suggestion
dotnet_diagnostic.IDE0058.severity = suggestion
