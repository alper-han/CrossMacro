<Project>
  <PropertyGroup>
    <!-- Disable the workload resolver on minimal SDK distributions. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <MeziantouAnalysisMode>all-warnings</MeziantouAnalysisMode>
    <!-- Native AOT readiness defaults. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Expand grouped trim warnings into individual diagnostics. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RepositoryVersionFile>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'VERSION'))</RepositoryVersionFile>
    <CrossMacroVersion>$([System.IO.File]::ReadAllText('$(RepositoryVersionFile)').Trim())</CrossMacroVersion>
    <Version Condition="'$(Version)' == ''">$(CrossMacroVersion)</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">$(CrossMacroVersion).0</FileVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(CrossMacroVersion).0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == '' and '$(CrossMacroSourceRevision)' != ''">$(Version)+$(CrossMacroSourceRevision)</InformationalVersion>
    <!-- Analyzers (compiler, .NET, IDE and third-party packages) run only in Debug builds that are
         not part of a publish profile. Release and packaging builds skip them entirely, including
         the third-party analyzer package references below. Override with -p:CrossMacroRunAnalyzers=true|false.
         Evaluated here, before project bodies, so it only sees command-line and environment properties. -->
    <CrossMacroRunAnalyzers Condition="'$(CrossMacroRunAnalyzers)' == '' and ('$(Configuration)' == 'Release' or '$(CrossMacroPublishProfile)' != '')">false</CrossMacroRunAnalyzers>
    <CrossMacroRunAnalyzers Condition="'$(CrossMacroRunAnalyzers)' == ''">true</CrossMacroRunAnalyzers>
    <RunAnalyzersDuringBuild Condition="'$(CrossMacroRunAnalyzers)' == 'false'">false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(CrossMacroRunAnalyzers)' == 'false'">false</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <ItemGroup Condition="'$(CrossMacroRunAnalyzers)' == 'true'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and ('$(CI)' == 'true' or '$(CI)' == '1')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <!-- Warning-level diagnostics are the single production CI gate. Keep editor suggestions advisory. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Shared plumbing and analyzer policy for test projects. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test assemblies are self-hosted executables; centralize the required output contract. -->
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
