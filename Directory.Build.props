<Project>
  <PropertyGroup>
    <!-- Disable the workload resolver on minimal SDK distributions. -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <MeziantouAnalysisMode>all-warnings</MeziantouAnalysisMode>
    <!-- Native AOT readiness defaults. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Expand grouped trim warnings into individual diagnostics. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RepositoryVersionFile>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'VERSION'))</RepositoryVersionFile>
    <CrossMacroVersion>$([System.IO.File]::ReadAllText('$(RepositoryVersionFile)').Trim())</CrossMacroVersion>
    <Version Condition="'$(Version)' == ''">$(CrossMacroVersion)</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">$(CrossMacroVersion).0</FileVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(CrossMacroVersion).0</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == '' and '$(CrossMacroSourceRevision)' != ''">$(Version)+$(CrossMacroSourceRevision)</InformationalVersion>
    <!-- Keep release, publish, and packaging builds free of diagnostic analyzer execution. This property also controls third-party analyzer package references. -->
    <EnableThirdPartyAnalyzers Condition="'$(EnableThirdPartyAnalyzers)' == '' and ('$(Configuration)' == 'Release' or '$(PublishAot)' == 'true' or '$(CrossMacroPublishProfile)' != '' or '$(DisableAnalyzers)' == 'true')">false</EnableThirdPartyAnalyzers>
    <EnableThirdPartyAnalyzers Condition="'$(EnableThirdPartyAnalyzers)' == ''">true</EnableThirdPartyAnalyzers>
    <RunAnalyzersDuringBuild Condition="'$(EnableThirdPartyAnalyzers)' == 'false'">false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(EnableThirdPartyAnalyzers)' == 'false'">false</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableThirdPartyAnalyzers)' == 'true'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and ('$(CI)' == 'true' or '$(CI)' == '1')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <!-- Warning-level diagnostics are the single production CI gate. Keep editor suggestions advisory. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">
     <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</RuntimeIdentifier>
     <RuntimeIdentifier Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Override analyzer settings specifically for test projects -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- xUnit v3 test assemblies are self-hosted executables; centralize the required output contract. -->
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
</Project>
