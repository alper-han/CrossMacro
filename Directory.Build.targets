<Project>
  <PropertyGroup>
    <!-- Disable Avalonia telemetry task writes to user profile paths in restricted environments. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <!--
    Release publish policy is selected by the packaging recipe through one
    explicit profile.  Platform-specific recipes still own the RID, output
    path, native toolchain and package format; the invariant .NET publish
    flags live here so those recipes cannot silently drift apart.
  -->
  <PropertyGroup Condition="'$(CrossMacroPublishProfile)' == 'native-aot'">
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- Native AOT supplies the final executable; do not generate an apphost. -->
    <UseAppHost>false</UseAppHost>
    <!-- Keep SDK RID inference aligned with the AOT output model. -->
    <_RuntimeIdentifierUsesAppHost>false</_RuntimeIdentifierUsesAppHost>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <IlcTrimMetadata>true</IlcTrimMetadata>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <Target Name="ValidateCrossMacroPublishProfile" BeforeTargets="PrepareForBuild"
          Condition="'$(CrossMacroPublishProfile)' != ''">
    <Error Condition="'$(CrossMacroPublishProfile)' != 'native-aot'"
           Text="Unknown CrossMacroPublishProfile '$(CrossMacroPublishProfile)'. Expected native-aot." />
    <Error Condition="'$(CrossMacroPublishProfile)' == 'native-aot' and '$(PublishAot)' != 'true'"
           Text="CrossMacro native-aot publish profile requires PublishAot=true." />
    <Error Condition="'$(CrossMacroPublishProfile)' != '' and '$(SelfContained)' != 'true'"
           Text="CrossMacro publish profiles require SelfContained=true." />
    <Error Condition="'$(CrossMacroPublishProfile)' == 'native-aot' and '$(PublishReadyToRun)' == 'true'"
           Text="CrossMacro native-aot publish profile requires PublishReadyToRun=false." />
  </Target>

  <Target Name="AvaloniaStats" />

  <!-- DesignerSupport is design-time only; exclude it from Windows portable publish. -->
  <Target Name="ExcludeAvaloniaDesignerSupportFromPortableRuntime"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CrossMacroWindowsPortableAot)' == 'true' and '$(OutputType)' == 'WinExe'">
    <ItemGroup>
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets->WithMetadataValue('Filename', 'Avalonia.DesignerSupport'))" />
    </ItemGroup>
  </Target>

  <!-- Exclude embedded native runtime libraries from publish folder in Windows Portable AOT builds. -->
  <Target Name="ExcludeEmbeddedNativeLibrariesFromPortableAotPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CrossMacroWindowsPortableAot)' == 'true'">
    <ItemGroup>
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets->WithMetadataValue('Filename', 'libSkiaSharp'))" />
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets->WithMetadataValue('Filename', 'libHarfBuzzSharp'))" />
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets->WithMetadataValue('Filename', 'av_libglesv2'))" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateCrossMacroPublishModes" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PublishAot)' == 'true' and '$(PublishReadyToRun)' == 'true'"
           Text="CrossMacro publish profiles are mutually exclusive: PublishAot=true requires PublishReadyToRun=false." />
  </Target>
</Project>
