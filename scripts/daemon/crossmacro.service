[Unit]
Description=CrossMacro Input Daemon Service
Documentation=https://github.com/alper-han/CrossMacro
After=polkit.service
Wants=polkit.service

[Service]
Type=notify
User=crossmacro
Group=crossmacro
SupplementaryGroups=input uinput
ExecStart=/usr/lib/crossmacro/daemon/CrossMacro.Daemon
Restart=on-failure
RestartSec=5

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
# Keep disabled for .NET runtime compatibility across distros.
# Some environments crash early (SIGSEGV) when executable mappings are denied.
MemoryDenyWriteExecute=no
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes

# The daemon runs unprivileged and needs a single capability: evdev nodes are opened
# read-only, and OpenRazer, Solaar and Piper udev rules change the permissions of
# /dev/input/event* so the `input` group can no longer read them. CAP_DAC_READ_SEARCH
# bypasses read permission checks only; it grants no write access (issue #18).
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

# Allow write to /dev/input and /dev/uinput
ReadWritePaths=/dev/input /dev/uinput /run/crossmacro

# Create runtime directory for socket
RuntimeDirectory=crossmacro
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# Persistent audit log, readable only by the daemon user and root
LogsDirectory=crossmacro
LogsDirectoryMode=0700

# Resource limits
LimitNOFILE=1024
# Bounds threads of this unit only. RLIMIT_NPROC (LimitNPROC=) counts every thread of the
# uid, so a small value starves the .NET thread pool on many-core machines.
TasksMax=512

[Install]
WantedBy=multi-user.target
