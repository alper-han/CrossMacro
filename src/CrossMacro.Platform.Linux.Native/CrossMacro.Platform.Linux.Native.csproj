<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Native ABI files keep the CrossMacro.Platform.Linux.Native namespace while living under the Native folder. -->
    <RootNamespace>CrossMacro.Platform.Linux</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CrossMacro.Core/CrossMacro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrossMacro.Platform.Linux.Tests" />
    <InternalsVisibleTo Include="CrossMacro.Daemon.Tests" />
  </ItemGroup>

</Project>
