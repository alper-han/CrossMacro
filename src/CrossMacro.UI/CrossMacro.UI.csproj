<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CrossMacro.UI.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateResourceDesignerFiles>true</GenerateResourceDesignerFiles>
    <Description>Cross-platform mouse and keyboard macro recorder and automation tool with a macro editor, scheduling, text expansion, and screen recognition.</Description>
  </PropertyGroup>

  <!-- Trimmer roots are defined in host entry projects (UI.Windows/UI.Linux/UI.MacOS),
       because trimming decisions are made against the published entry assembly. -->

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- Design-time view models only back <Design.DataContext> in the IDE previewer. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="ViewModels\Design\**" />
  </ItemGroup>

  <!-- Built-in themes and the user-facing sample/template are embedded resources:
       the runtime catalog and the theme-folder provisioner stream them from the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Themes/*.json" />
    <EmbeddedResource Include="Themes/UserThemes.README.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization/Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <CustomToolNamespace>CrossMacro.UI.Localization</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Localization/Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CrossMacro.Core/CrossMacro.Core.csproj" />
    <ProjectReference Include="../CrossMacro.Application/CrossMacro.Application.csproj" />
    <ProjectReference Include="../CrossMacro.Platform.Abstractions/CrossMacro.Platform.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CrossMacro.UI.Tests" />
    <InternalsVisibleTo Include="CrossMacro.UI" />
  </ItemGroup>
</Project>
