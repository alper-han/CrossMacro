<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CrossMacro.UI.Views.Dialogs.UnsavedChangesDialog"
        Title="Unsaved Changes"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BackgroundColor}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">
    <Border BorderBrush="{DynamicResource SurfaceHoverColor}" BorderThickness="1">
        <StackPanel Spacing="20" Margin="24">
            <TextBlock Name="TitleText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Name="MessageText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Name="CancelButton"
                        Classes="secondary"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        Padding="16,8"/>
                <Button Name="DiscardButton"
                        Classes="danger"
                        Click="DiscardButton_Click"
                        Padding="16,8"/>
                <Button Name="SaveButton"
                        Classes="primary"
                        Click="SaveButton_Click"
                        Padding="16,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
