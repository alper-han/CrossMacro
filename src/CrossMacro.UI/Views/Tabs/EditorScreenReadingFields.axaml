<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmEditor="using:CrossMacro.UI.ViewModels.Editor"
             xmlns:local="using:CrossMacro.UI.Views.Tabs"
             xmlns:conv="using:CrossMacro.UI.Converters"
             xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
             x:Class="CrossMacro.UI.Views.Tabs.EditorScreenReadingFields"
             x:DataType="vmEditor:EditorViewModel">

    <UserControl.Resources>
        <conv:NullableIntConverter x:Key="NullableIntConverter"/>
        <conv:NullableDoubleConverter x:Key="NullableDoubleConverter"/>
        <conv:HexColorBrushConverter x:Key="HexColorBrushConverter"/>
        <conv:LocalizedEnumConverter x:Key="ScreenTargetColorSourceDisplayConverter" KeyPrefix="Editor_TargetColorSource"/>
        <conv:LocalizedEnumConverter x:Key="ImageMatchModeDisplayConverter" KeyPrefix="Editor_ImageMatchMode"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Pixel color -->
        <StackPanel Spacing="6" IsVisible="{Binding Fields.ShowPixelColorFields}">
            <TextBlock Text="{localization:Loc Editor_PixelColorAction}" Classes="field-label"/>
            <StackPanel Spacing="4">
                <TextBlock Text="{localization:Loc Editor_CoordinateMode}" Classes="field-hint"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                     <RadioButton GroupName="ScreenReadingCoordMode"
                                  IsChecked="{Binding SelectedActionIsAbsolute, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                         <TextBlock Text="{localization:Loc Editor_Absolute}" FontSize="12"/>
                     </RadioButton>
                     <RadioButton GroupName="ScreenReadingCoordMode"
                                  IsChecked="{Binding SelectedActionIsRelative, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                         <TextBlock Text="{localization:Loc Editor_Relative}" FontSize="12"/>
                     </RadioButton>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{localization:Loc Editor_ScreenPoint}" Classes="field-hint"/>
            <Grid ColumnDefinitions="*,8,*">
                <TextBox Text="{Binding SelectedAction.ScreenX, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="X"
                         Classes="field"/>
                <TextBox Grid.Column="2"
                         Text="{Binding SelectedAction.ScreenY, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Y"
                         Classes="field"/>
            </Grid>
            <Button Command="{Binding CaptureMouseAsync}"
                    Classes="primary compact"
                    IsVisible="{Binding !IsCapturingPosition}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                    <TextBlock Text="{localization:Loc Editor_CapturePosition}"/>
                </StackPanel>
            </Button>
            <local:CancelCaptureButton IsVisible="{Binding IsCapturingPosition}"/>
            <TextBox Text="{Binding SelectedAction.ScreenColorVariableName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{localization:Loc Editor_ColorVariableNamePlaceholder}"
                     Classes="field"/>
        </StackPanel>

        <!-- Wait color -->
        <StackPanel Spacing="6" IsVisible="{Binding Fields.ShowWaitColorFields}">
            <TextBlock Text="{localization:Loc Editor_WaitColorAction}" Classes="field-label"/>
            <TextBlock Text="{localization:Loc Editor_ScreenPoint}" Classes="field-hint"/>
            <Grid ColumnDefinitions="*,8,*">
                <TextBox Text="{Binding SelectedAction.ScreenX, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="X"
                         Classes="field"/>
                <TextBox Grid.Column="2"
                         Text="{Binding SelectedAction.ScreenY, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Y"
                         Classes="field"/>
            </Grid>
            <Button Command="{Binding CaptureMouseAsync}"
                    Classes="primary compact"
                    IsVisible="{Binding !IsCapturingPosition}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                    <TextBlock Text="{localization:Loc Editor_CapturePosition}"/>
                </StackPanel>
            </Button>
            <local:CancelCaptureButton IsVisible="{Binding IsCapturingPosition}"/>
            <TextBlock Text="{localization:Loc Editor_TargetColorSource}" Classes="field-hint"/>
            <ComboBox ItemsSource="{Binding Fields.ScreenTargetColorSources}"
                      SelectedItem="{Binding SelectedAction.ScreenTargetColorSource}"
                      Background="{DynamicResource SurfaceHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ScreenTargetColorSourceDisplayConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{localization:Loc Editor_TargetColorHex}" Classes="field-hint" IsVisible="{Binding Fields.ShowScreenTargetColorHexInput}"/>
             <Grid ColumnDefinitions="Auto,8,*,8,Auto" IsVisible="{Binding Fields.ShowScreenTargetColorHexInput}">
                   <Border Width="32"
                          Height="32"
                        CornerRadius="4"
                        Background="{Binding Fields.ScreenReadingColorPreviewHex, Converter={StaticResource HexColorBrushConverter}}"
                        BorderBrush="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding Fields.ShowScreenReadingColorPreview}"/>
                <TextBox Grid.Column="2"
                          Text="{Binding SelectedAction.ScreenColorHex, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="RRGGBB"
                         Classes="field"
                          MaxLength="6"/>
                <Button Grid.Column="4"
                        Command="{Binding CaptureTargetColorAsync}"
                        Classes="primary compact"
                        IsVisible="{Binding !IsCapturingTargetColor}"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                        <TextBlock Text="{localization:Loc Editor_CaptureTargetColor}"/>
                    </StackPanel>
                </Button>
                <local:CancelCaptureButton Grid.Column="4" IsVisible="{Binding IsCapturingTargetColor}"/>
              </Grid>
            <TextBlock Text="{localization:Loc Editor_TargetColorVariable}" Classes="field-hint" IsVisible="{Binding Fields.ShowScreenTargetColorVariableInput}"/>
            <TextBox Text="{Binding SelectedAction.ScreenTargetColorVariableName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{localization:Loc Editor_ColorVariableNamePlaceholder}"
                     IsVisible="{Binding Fields.ShowScreenTargetColorVariableInput}"
                     Classes="field"/>
            <ComboBox ItemsSource="{Binding Variables.AvailableColorNames}"
                      SelectedItem="{Binding Variables.ScreenTargetColor.Selected}"
                      IsVisible="{Binding Fields.ShowScreenTargetColorVariablePicker}"
                      Background="{DynamicResource SurfaceHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Stretch"/>
            <StackPanel Spacing="3">
                <TextBlock Text="{localization:Loc Editor_TimeoutMs}" Classes="field-hint"/>
                <TextBox Text="{Binding SelectedAction.ScreenTimeoutMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="5000"
                         Classes="field"/>
            </StackPanel>
            <TextBlock Text="{localization:Loc Editor_ResultVariableName}" Classes="field-hint"/>
            <TextBox Text="{Binding SelectedAction.ScreenColorVariableName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="wait_ok"
                     Classes="field"/>
        </StackPanel>

        <!-- Pixel search -->
        <StackPanel Spacing="6" IsVisible="{Binding Fields.ShowPixelSearchFields}">
            <TextBlock Text="{localization:Loc Editor_PixelSearchAction}" Classes="field-label"/>
            <TextBlock Text="{localization:Loc Editor_SearchRegion}" Classes="field-hint"/>
             <Grid ColumnDefinitions="*,8,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Left}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenLeft, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Left}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Top}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenTop, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Top}"
                             Classes="field"/>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Width}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenWidth, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Width}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Height}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenHeight, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Height}"
                             Classes="field"/>
                </StackPanel>
             </Grid>
            <Grid ColumnDefinitions="*,8,*">
                <Button Command="{Binding CapturePixelSearchTopLeftAsync}"
                        Classes="primary compact"
                        IsVisible="{Binding !IsCapturingPixelSearchTopLeft}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                        <TextBlock Text="{localization:Loc Editor_CaptureRegionTopLeft}"/>
                    </StackPanel>
                </Button>
                <local:CancelCaptureButton IsVisible="{Binding IsCapturingPixelSearchTopLeft}"/>
                <Button Grid.Column="2"
                        Command="{Binding CapturePixelSearchBottomRightAsync}"
                        Classes="primary compact"
                        IsVisible="{Binding !IsCapturingPixelSearchBottomRight}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                        <TextBlock Text="{localization:Loc Editor_CaptureRegionBottomRight}"/>
                    </StackPanel>
                </Button>
                <local:CancelCaptureButton Grid.Column="2" IsVisible="{Binding IsCapturingPixelSearchBottomRight}"/>
            </Grid>
            <TextBlock Text="{localization:Loc Editor_TargetColorSource}" Classes="field-hint"/>
            <ComboBox ItemsSource="{Binding Fields.ScreenTargetColorSources}"
                      SelectedItem="{Binding SelectedAction.ScreenTargetColorSource}"
                      Background="{DynamicResource SurfaceHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ScreenTargetColorSourceDisplayConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{localization:Loc Editor_TargetColorHex}" Classes="field-hint" IsVisible="{Binding Fields.ShowScreenTargetColorHexInput}"/>
            <Grid ColumnDefinitions="Auto,8,*,8,Auto" IsVisible="{Binding Fields.ShowScreenTargetColorHexInput}">
                <Border Width="32"
                        Height="32"
                        CornerRadius="4"
                        Background="{Binding Fields.ScreenReadingColorPreviewHex, Converter={StaticResource HexColorBrushConverter}}"
                        BorderBrush="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding Fields.ShowScreenReadingColorPreview}"/>
                <TextBox Grid.Column="2"
                          Text="{Binding SelectedAction.ScreenColorHex, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="RRGGBB"
                         Classes="field"
                          MaxLength="6"/>
                <Button Grid.Column="4"
                        Command="{Binding CaptureTargetColorAsync}"
                        Classes="primary compact"
                        IsVisible="{Binding !IsCapturingTargetColor}"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                        <TextBlock Text="{localization:Loc Editor_CaptureTargetColor}"/>
                    </StackPanel>
                </Button>
                <local:CancelCaptureButton Grid.Column="4" IsVisible="{Binding IsCapturingTargetColor}"/>
            </Grid>
            <TextBlock Text="{localization:Loc Editor_TargetColorVariable}" Classes="field-hint" IsVisible="{Binding Fields.ShowScreenTargetColorVariableInput}"/>
            <TextBox Text="{Binding SelectedAction.ScreenTargetColorVariableName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{localization:Loc Editor_ColorVariableNamePlaceholder}"
                     IsVisible="{Binding Fields.ShowScreenTargetColorVariableInput}"
                     Classes="field"/>
            <ComboBox ItemsSource="{Binding Variables.AvailableColorNames}"
                      SelectedItem="{Binding Variables.ScreenTargetColor.Selected}"
                      IsVisible="{Binding Fields.ShowScreenTargetColorVariablePicker}"
                      Background="{DynamicResource SurfaceHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Stretch"/>
            <TextBlock Text="{localization:Loc Editor_FoundVariables}" Classes="field-hint"/>
            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_FoundXVariableNamePlaceholder}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenFoundXVariableName, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_FoundXVariableNamePlaceholder}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_FoundYVariableNamePlaceholder}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenFoundYVariableName, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_FoundYVariableNamePlaceholder}"
                             Classes="field"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{localization:Loc Editor_FoundVariableName}" Classes="field-note"/>
            <TextBox Text="{Binding SelectedAction.ScreenFoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="found"
                      Classes="field"/>
            <TextBlock Text="{localization:Loc Editor_Tolerance}" Classes="field-note"/>
            <TextBox Text="{Binding SelectedAction.ScreenTolerance, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{localization:Loc Editor_Tolerance}"
                     Classes="field"/>
            <TextBlock Text="{localization:Loc Editor_TimeoutMs}" Classes="field-note"/>
            <TextBox Text="{Binding SelectedAction.ScreenTimeoutMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="5000"
                     Classes="field"/>
        </StackPanel>

        <!-- Image search -->
        <StackPanel Spacing="6" IsVisible="{Binding Fields.ShowImageSearchFields}">
             <TextBlock Text="{localization:Loc Editor_ImageSearchAction}" Classes="field-label"/>
             <TextBlock Text="{localization:Loc Editor_ImageMatchMode}" Classes="field-hint"/>
             <ComboBox ItemsSource="{Binding Fields.ImageMatchModes}"
                       SelectedItem="{Binding SelectedImageSearchMatchMode, Mode=TwoWay}"
                       Background="{DynamicResource SurfaceHoverBrush}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Stretch">
                 <ComboBox.ItemTemplate>
                     <DataTemplate>
                         <TextBlock Text="{Binding Converter={StaticResource ImageMatchModeDisplayConverter}}"/>
                     </DataTemplate>
                 </ComboBox.ItemTemplate>
             </ComboBox>
            <Button Command="{Binding ImportImageAssetAsync}"
                    Classes="primary compact"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:EmojiAppIcon Icon="FolderOpen" Classes="emoji-sm"/>
                    <TextBlock Text="{localization:Loc Editor_ImportImageAsset}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{localization:Loc Editor_ImageAsset}" Classes="field-hint"/>
            <ComboBox ItemsSource="{Binding ImageAssetNames}"
                      SelectedItem="{Binding SelectedAction.ImageAssetName, Mode=TwoWay}"
                      IsVisible="{Binding HasImageAssets}"
                      Background="{DynamicResource SurfaceHoverBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      HorizontalAlignment="Stretch"/>
            <StackPanel Spacing="4" IsVisible="{Binding ImagePreview.IsVisible}">
                <TextBlock Text="{localization:Loc Editor_ImageAssetPreview}"
                           Classes="field-hint"/>
                <Border Classes="notice-card"
                        HorizontalAlignment="Left"
                        MaxWidth="640"
                        MaxHeight="360"
                        Padding="8">
                    <Grid>
                        <Grid.Background>
                            <DrawingBrush TileMode="Tile"
                                          SourceRect="0,0,16,16"
                                          DestinationRect="0,0,16,16"
                                          Stretch="None">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="{DynamicResource SurfaceBrush}">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,16,16"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="{DynamicResource SurfaceHoverBrush}">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,8,8"/>
                                                    <RectangleGeometry Rect="8,8,8,8"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.Background>
                        <Image Source="{Binding ImagePreview.Bitmap}"
                               Stretch="Uniform"
                               MaxWidth="640"
                               MaxHeight="360"/>
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock Text="{localization:Loc Editor_ImageAssetImportHint}"
                       Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !HasImageAssets}"/>
            <TextBlock Text="{localization:Loc Editor_SearchRegion}" Classes="field-hint"/>
            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Left}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ImageSearchRegionLeftToken, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Left}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Top}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ImageSearchRegionTopToken, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Top}"
                             Classes="field"/>
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Width}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ImageSearchRegionWidthToken, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Width}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_Height}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ImageSearchRegionHeightToken, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_Height}"
                             Classes="field"/>
                </StackPanel>
             </Grid>
             <Grid ColumnDefinitions="*,8,*">
                 <Button Command="{Binding CapturePixelSearchTopLeftAsync}"
                         Classes="primary compact"
                         IsVisible="{Binding !IsCapturingPixelSearchTopLeft}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center">
                     <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                         <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                         <TextBlock Text="{localization:Loc Editor_CaptureRegionTopLeft}"/>
                     </StackPanel>
                 </Button>
                 <local:CancelCaptureButton IsVisible="{Binding IsCapturingPixelSearchTopLeft}"/>
                 <Button Grid.Column="2"
                         Command="{Binding CapturePixelSearchBottomRightAsync}"
                         Classes="primary compact"
                         IsVisible="{Binding !IsCapturingPixelSearchBottomRight}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center">
                     <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                         <icons:EmojiAppIcon Icon="Location" Classes="emoji-sm"/>
                         <TextBlock Text="{localization:Loc Editor_CaptureRegionBottomRight}"/>
                     </StackPanel>
                 </Button>
                 <local:CancelCaptureButton Grid.Column="2" IsVisible="{Binding IsCapturingPixelSearchBottomRight}"/>
             </Grid>
             <TextBlock Text="{localization:Loc Editor_FoundVariables}" Classes="field-hint" IsVisible="{Binding Fields.ShowImageOutputVariableFields}"/>
            <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Fields.ShowImageOutputVariableFields}">
                <StackPanel Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_FoundXVariableNamePlaceholder}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenFoundXVariableName, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_FoundXVariableNamePlaceholder}"
                             Classes="field"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="{localization:Loc Editor_FoundYVariableNamePlaceholder}" Classes="field-note"/>
                    <TextBox Text="{Binding SelectedAction.ScreenFoundYVariableName, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{localization:Loc Editor_FoundYVariableNamePlaceholder}"
                             Classes="field"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{localization:Loc Editor_FoundVariableName}" Classes="field-note" IsVisible="{Binding Fields.ShowImageOutputVariableFields}"/>
            <TextBox Text="{Binding SelectedAction.ScreenFoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="found"
                     Classes="field"
                     IsVisible="{Binding Fields.ShowImageOutputVariableFields}"/>
            <TextBlock Text="{localization:Loc Editor_TimeoutMs}" Classes="field-note" IsVisible="{Binding Fields.ShowImageWaitTimeoutField}"/>
            <TextBox Text="{Binding SelectedAction.ScreenTimeoutMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="5000"
                     Classes="field"
                     IsVisible="{Binding Fields.ShowImageWaitTimeoutField}"/>
            <StackPanel Spacing="3">
                <TextBlock Text="{localization:Loc Editor_ImageSearchSimilarity}" Classes="field-note"/>
                <TextBox Text="{Binding SelectedAction.ImageSearchSimilarity, Converter={StaticResource NullableDoubleConverter}, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="0.95"
                         Classes="field"/>
            </StackPanel>
         </StackPanel>
    </StackPanel>
</UserControl>
