<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossMacro.UI.ViewModels"
             xmlns:designVm="using:CrossMacro.UI.ViewModels.Design"
             xmlns:local="using:CrossMacro.UI.Views.Tabs"
             xmlns:beh="using:CrossMacro.UI.Behaviors"
             xmlns:conv="using:CrossMacro.UI.Converters"
             xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="CrossMacro.UI.Views.Tabs.EditorTabView"
             x:DataType="vm:EditorViewModel">

    <Design.DataContext>
        <designVm:DesignEditorViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <conv:NullableIntConverter x:Key="NullableIntConverter"/>
        <conv:HexColorBrushConverter x:Key="HexColorBrushConverter"/>
        <conv:IndentLevelToMarginConverter x:Key="IndentLevelToMarginConverter"/>
        <conv:ScriptOperandTypeDisplayConverter x:Key="ScriptOperandTypeDisplayConverter"/>
        <conv:ScriptConditionOperatorDisplayConverter x:Key="ScriptConditionOperatorDisplayConverter"/>
        <conv:ScriptArithmeticOperationDisplayConverter x:Key="ScriptArithmeticOperationDisplayConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- Main Content: Action List + Properties -->
        <Grid Grid.Row="0" ColumnDefinitions="1*,1*">

            <!-- Left: Action List -->
            <Border Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="{localization:Loc Editor_Actions}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <CheckBox IsChecked="{Binding HideMouseMoves}"
                                      IsVisible="{Binding ShowHideMouseMovesToggle}"
                                      Content="{localization:Loc Editor_HideMouseMoves}"
                                      ToolTip.Tip="{localization:Loc Editor_HideMouseMovesTooltip}"
                                      VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding HideShortWaits}"
                                      IsVisible="{Binding ShowHideShortWaitsToggle}"
                                      Content="{localization:Loc Editor_HideShortWaits}"
                                      ToolTip.Tip="{localization:Loc Editor_HideShortWaitsTooltip}"
                                      VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding SimplifyMovement}"
                                      IsVisible="{Binding ShowSimplifyMovementToggle}"
                                      Content="{localization:Loc Editor_SimplifyMovement}"
                                      ToolTip.Tip="{localization:Loc Editor_SimplifyMovementTooltip}"
                                      VerticalAlignment="Center"/>
                        </WrapPanel>
                        <TextBlock Text="{localization:Loc Editor_HiddenEventsHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   IsVisible="{Binding HasHiddenEvents}"/>
                    </StackPanel>

                        <ListBox Grid.Row="1"
                              ItemsSource="{Binding ActionListItems}"
                              beh:ListBoxSelectedActionIndices.SelectedUnderlyingIndices="{Binding SelectedActionUnderlyingIndices}"
                              Classes="editor-action-list"
                              Background="Transparent"
                               SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorActionListItem">
                                 <StackPanel Orientation="Horizontal"
                                             Spacing="6"
                                             Classes.noise="{Binding IsNoise}"
                                             Classes.important="{Binding IsImportant}"
                                             ToolTip.Tip="{Binding DisplayTooltip}"
                                             Margin="{Binding IndentLevel, Converter={StaticResource IndentLevelToMarginConverter}}">
                                    <Border Classes="editor-action-index-badge"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            MinWidth="24">
                                        <TextBlock Text="{Binding Index}"
                                                   Classes="editor-action-index"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Classes="editor-action-name"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Action List Buttons -->
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Command="{Binding RemoveSelectedActions}"
                                Classes="danger compact editor-toolbar-action"
                                IsEnabled="{Binding CanRemoveSelectedActions}"
                                ToolTip.Tip="{localization:Loc Editor_RemoveSelectedActionsTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{icons:AppIcon Minus}" Classes="app-icon"/>
                                <TextBlock Text="{localization:Loc Editor_Remove}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteHiddenEvents}"
                                Classes="danger compact editor-toolbar-action"
                                IsEnabled="{Binding CanDeleteHiddenEvents}"
                                IsVisible="{Binding ShowDeleteHiddenEvents}"
                                ToolTip.Tip="{localization:Loc Editor_DeleteHiddenEventsTooltip}">
                            <TextBlock Text="{localization:Loc Editor_DeleteHiddenEvents}"/>
                        </Button>
                        <Button Command="{Binding RemoveBlock}"
                                Classes="danger compact editor-toolbar-action"
                                IsEnabled="{Binding CanRemoveBlock}"
                                IsVisible="{Binding CanRemoveBlock}"
                                ToolTip.Tip="{localization:Loc Editor_RemoveBlockTooltip}">
                            <TextBlock Text="{localization:Loc Editor_Block}"/>
                        </Button>
                        <Button Command="{Binding MoveSelectedActionsUp}"
                                Classes="secondary compact editor-toolbar-action"
                                IsEnabled="{Binding CanMoveSelectedActionsUp}"
                                ToolTip.Tip="{localization:Loc Editor_MoveUpTooltip}">
                            <PathIcon Data="{icons:AppIcon ArrowUp}" Classes="app-icon"/>
                        </Button>
                        <Button Command="{Binding MoveSelectedActionsDown}"
                                Classes="secondary compact editor-toolbar-action"
                                IsEnabled="{Binding CanMoveSelectedActionsDown}"
                                ToolTip.Tip="{localization:Loc Editor_MoveDownTooltip}">
                            <PathIcon Data="{icons:AppIcon ArrowDown}" Classes="app-icon"/>
                        </Button>
                        <Button Command="{Binding DuplicateSelectedActions}"
                                Classes="secondary compact editor-toolbar-action"
                                IsEnabled="{Binding CanDuplicateSelectedActions}"
                                ToolTip.Tip="{localization:Loc Editor_DuplicateTooltip}">
                            <icons:EmojiAppIcon Icon="Clipboard" Width="16" Height="16"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Right: Properties Panel -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">

                        <!-- Add New Action Section -->
                        <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{localization:Loc Editor_AddNewAction}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{localization:Loc Editor_ActionGroupLabel}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"/>
                                <ComboBox ItemsSource="{Binding AddableActionGroups}"
                                          SelectedItem="{Binding NewActionGroup}"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditorActionPickerGroup">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{localization:Loc Editor_ActionChoiceLabel}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"/>
                                <ComboBox ItemsSource="{Binding NewActionChoices}"
                                          SelectedItem="{Binding NewActionChoice}"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EditorActionPickerChoice">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Command="{Binding AddAction}"
                                        Classes="primary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <PathIcon Data="{icons:AppIcon Add}" Classes="app-icon"/>
                                        <TextBlock Text="{localization:Loc Editor_AddAction}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Selected Action Properties -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowSingleSelectedActionProperties}">
                            <TextBlock Text="{localization:Loc Editor_SelectedActionProperties}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Action Type (Read-only display) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{localization:Loc Editor_Type}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,6">
                                    <TextBlock Text="{Binding SelectedAction.Type, Converter={x:Static conv:ActionTypeConverters.DisplayText}}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <Button Command="{Binding InsertElseBlock}"
                                    Classes="secondary compact"
                                    IsVisible="{Binding CanInsertElseBlock}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <TextBlock Text="{localization:Loc Editor_InsertElseBlock}"/>
                            </Button>

                            <StackPanel Spacing="4" IsVisible="{Binding ShowCurrentPositionToggle}">
                                <CheckBox IsChecked="{Binding SelectedAction.UseCurrentPosition}"
                                          Content="{Binding CurrentPositionToggleLabel}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{localization:Loc Editor_CurrentPositionHint}"
                                           Classes="caption"
                                           IsVisible="{Binding SelectedAction.UseCurrentPosition}"/>
                            </StackPanel>

                            <!-- Coordinates (MouseMove, MouseClick, MouseDown, MouseUp) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowCoordinates}">
                                <TextBlock Text="{localization:Loc Editor_Coordinates}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Grid ColumnDefinitions="*,8,*">
                                    <TextBox Text="{Binding SelectedAction.CoordinateXToken, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="X"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedAction.CoordinateYToken, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Y"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </Grid>
                                <Button Command="{Binding CaptureMouseAsync}"
                                        Classes="primary compact"
                                        IsVisible="{Binding !IsCapturingPosition}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:EmojiAppIcon Icon="Location" Width="16" Height="16"/>
                                        <TextBlock Text="{localization:Loc Editor_CapturePosition}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CancelCapture}"
                                        Classes="danger compact"
                                        IsVisible="{Binding IsCapturingPosition}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                        <TextBlock Text="{localization:Loc Editor_CancelCapture}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Absolute/Relative Toggle (all coordinate-bearing mouse actions) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowCoordModeToggle}">
                                <TextBlock Text="{localization:Loc Editor_CoordinateMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                     <RadioButton GroupName="CoordMode"
                                                  IsChecked="{Binding SelectedActionIsAbsolute, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                         <TextBlock Text="{localization:Loc Editor_Absolute}" FontSize="12"/>
                                     </RadioButton>
                                     <RadioButton GroupName="CoordMode"
                                                  IsChecked="{Binding SelectedActionIsRelative, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                         <TextBlock Text="{localization:Loc Editor_Relative}" FontSize="12"/>
                                     </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Mouse Button (MouseClick, MouseDown, MouseUp) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowMouseButton}">
                                <TextBlock Text="{localization:Loc Editor_MouseButton}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding MouseButtons}"
                                          SelectedItem="{Binding SelectedAction.Button}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding !ShowImageClickButton}"/>
                                <ComboBox ItemsSource="{Binding ImageClickButtons}"
                                          SelectedItem="{Binding SelectedAction.Button}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding ShowImageClickButton}"/>
                            </StackPanel>

                            <!-- Key Code (KeyPress, KeyDown, KeyUp) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowKeyCode}">
                                <TextBlock Text="{localization:Loc Editor_Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Grid ColumnDefinitions="80,8,*">
                                    <TextBox Text="{Binding SelectedAction.KeyCode, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_KeyPlaceholder}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"
                                             MaxLength="3"/>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="4"
                                            Padding="12,6">
                                        <TextBlock Text="{Binding SelectedAction.KeyName}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <Button Command="{Binding CaptureKeyAsync}"
                                        Classes="primary compact"
                                        IsVisible="{Binding !IsCapturingKey}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:EmojiAppIcon Icon="Keyboard" Width="16" Height="16"/>
                                        <TextBlock Text="{localization:Loc Editor_CaptureKey}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CancelCapture}"
                                        Classes="danger compact"
                                        IsVisible="{Binding IsCapturingKey}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                        <TextBlock Text="{localization:Loc Editor_CancelCapture}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Delay (Delay action only) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowDelay}">
                                <CheckBox IsChecked="{Binding SelectedAction.UseRandomDelay}"
                                          Content="{localization:Loc Editor_RandomizeDelay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowFixedDelayInput}">
                                    <TextBlock Text="{localization:Loc Editor_DelayDuration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox Text="{Binding SelectedAction.DelayDuration, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_DelayDurationPlaceholder}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowRandomDelayOptions}">
                                    <TextBlock Text="{localization:Loc Editor_RandomDelayRangeMs}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TextBox Text="{Binding SelectedAction.RandomDelayMinMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Min}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SelectedAction.RandomDelayMaxMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Max}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Scroll Amount (ScrollVertical, ScrollHorizontal) -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowScrollAmount}">
                                <TextBlock Text="{localization:Loc Editor_ScrollAmount}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ScrollAmount, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_Amount}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBlock Text="{localization:Loc Editor_ScrollHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <local:EditorScreenReadingFields IsVisible="{Binding ShowScreenReadingFields}"/>

                            <!-- Text input -->
                            <StackPanel Spacing="4" IsVisible="{Binding ShowTextInput}">
                                <TextBlock Text="{Binding TextInputLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedActionDisplayText, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding TextInputWatermark}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"
                                         AcceptsReturn="{Binding TextInputAcceptsReturn}"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MinHeight="96"
                                         MaxHeight="220"/>
                                <TextBlock Text="{Binding TextInputHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Set variable -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowSetVariableFields}">
                                <TextBlock Text="{localization:Loc Editor_SetVariable}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ScriptVariableName, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_VariableNamePlaceholder}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                          SelectedItem="{Binding SelectedSetVariableSuggestion}"
                                          IsVisible="{Binding ShowSetVariablePicker}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"/>
                                <ComboBox ItemsSource="{Binding ScriptValueTypes}"
                                          SelectedItem="{Binding SelectedAction.ScriptValueType}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox Text="{Binding SelectedAction.ScriptValue, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_Value}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBlock Text="{localization:Loc Editor_SetVariableHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Clipboard get -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowClipboardGetFields}">
                                <TextBlock Text="{localization:Loc Editor_ClipboardDestinationVariable}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ScriptVariableName, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_VariableNamePlaceholder}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                          SelectedItem="{Binding SelectedClipboardVariableSuggestion}"
                                          IsVisible="{Binding ShowClipboardVariablePicker}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{localization:Loc Editor_ClipboardGetHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Screenshot -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowScreenshotFields}">
                                <TextBlock Text="{localization:Loc Editor_ScreenshotAction}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox Text="{Binding SelectedAction.ScreenshotOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_ScreenshotOutputPathPlaceholder}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding BrowseScreenshotOutputPathAsync}"
                                            Classes="secondary compact">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:EmojiAppIcon Icon="FolderOpen" Width="16" Height="16"/>
                                            <TextBlock Text="{localization:Loc Editor_ScreenshotBrowse}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <CheckBox IsChecked="{Binding SelectedAction.ScreenshotCopyToClipboard}"
                                          Content="{localization:Loc Editor_ScreenshotCopyToClipboard}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <CheckBox IsChecked="{Binding SelectedAction.ScreenshotUseRegion}"
                                          Content="{localization:Loc Editor_ScreenshotUseRegion}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowScreenshotRegionFields}">
                                    <TextBlock Text="{localization:Loc Editor_ScreenshotRegion}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TextBox Text="{Binding SelectedAction.ScreenshotRegionX, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Left}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SelectedAction.ScreenshotRegionY, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Top}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TextBox Text="{Binding SelectedAction.ScreenshotRegionWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Width}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SelectedAction.ScreenshotRegionHeight, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Height}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button Command="{Binding CaptureScreenshotRegionStartAsync}"
                                                Classes="primary compact"
                                                IsVisible="{Binding !IsCapturingScreenshotRegionStart}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <icons:EmojiAppIcon Icon="Location" Width="16" Height="16"/>
                                                <TextBlock Text="{localization:Loc Editor_CaptureRegionTopLeft}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CancelCapture}"
                                                Classes="danger compact"
                                                IsVisible="{Binding IsCapturingScreenshotRegionStart}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                                <TextBlock Text="{localization:Loc Editor_CancelCapture}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Command="{Binding CaptureScreenshotRegionEndAsync}"
                                                Classes="primary compact"
                                                IsVisible="{Binding !IsCapturingScreenshotRegionEnd}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <icons:EmojiAppIcon Icon="Location" Width="16" Height="16"/>
                                                <TextBlock Text="{localization:Loc Editor_CaptureRegionBottomRight}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Command="{Binding CancelCapture}"
                                                Classes="danger compact"
                                                IsVisible="{Binding IsCapturingScreenshotRegionEnd}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                                <TextBlock Text="{localization:Loc Editor_CancelCapture}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="{localization:Loc Editor_ScreenshotHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{localization:Loc Editor_ScreenshotWarning}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Shell command -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowShellCommandFields}">
                                <TextBlock Text="{localization:Loc Editor_ShellMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding ShellCommandModes}"
                                          SelectedValue="{Binding SelectedAction.ShellCommandMode}"
                                          SelectedValueBinding="{Binding Value}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{localization:Loc Editor_ShellCommand}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ShellCommand, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_ShellCommandPlaceholder}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"
                                         AcceptsReturn="False"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowShellStandardInputFields}">
                                    <TextBlock Text="{localization:Loc Editor_ShellStandardInput}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox Text="{Binding SelectedAction.ShellStandardInput, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_ShellStandardInputPlaceholder}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             MaxHeight="160"/>
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowShellCaptureFields}">
                                    <TextBlock Text="{localization:Loc Editor_ShellCaptureTargets}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,8,*,8,*">
                                        <TextBox Text="{Binding SelectedAction.ShellExitCodeVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_ShellExitVariable}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding SelectedAction.ShellStandardOutputVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_ShellStdoutVariable}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding SelectedAction.ShellStandardErrorVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_ShellStderrVariable}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <TextBlock Text="{localization:Loc Editor_ShellCaptureHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{localization:Loc Editor_ShellOptions}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <TextBox Text="{Binding SelectedAction.ShellRetries, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_ShellRetries}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedAction.ShellBackoffMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_ShellBackoffMs}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBox Grid.Column="4"
                                             Text="{Binding SelectedAction.ShellTimeoutMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_ShellTimeoutMs}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </Grid>
                                <TextBlock Text="{localization:Loc Editor_ShellWarning}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{localization:Loc Editor_ShellFlatpakHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Window command -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowWindowCommandFields}">
                                <TextBlock Text="{localization:Loc Editor_WindowMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding WindowCommandModes}"
                                          SelectedValue="{Binding SelectedAction.WindowCommandMode}"
                                          SelectedValueBinding="{Binding Value}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowWindowActiveFieldSelector}">
                                    <TextBlock Text="{localization:Loc Editor_WindowActiveField}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding WindowActiveFields}"
                                              SelectedItem="{Binding SelectedAction.WindowActiveField}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowWindowSelectorFields}">
                                    <TextBlock Text="{localization:Loc Editor_WindowSelectorKind}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding WindowSearchSelectorKinds}"
                                              SelectedItem="{Binding SelectedAction.WindowSelectorKind}"
                                              IsVisible="{Binding ShowWindowSearchSelectorKinds}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <ComboBox ItemsSource="{Binding WindowFocusSelectorKinds}"
                                              SelectedItem="{Binding SelectedAction.WindowSelectorKind}"
                                              IsVisible="{Binding ShowWindowFocusSelectorKinds}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <ComboBox ItemsSource="{Binding WindowCloseSelectorKinds}"
                                              SelectedItem="{Binding SelectedAction.WindowSelectorKind}"
                                              IsVisible="{Binding ShowWindowCloseSelectorKinds}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBox Text="{Binding SelectedAction.WindowSelectorValue, UpdateSourceTrigger=PropertyChanged}"
                                             IsVisible="{Binding ShowWindowSelectorValueField}"
                                             PlaceholderText="{localization:Loc Editor_WindowSelectorValue}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowWindowCoordinateFields}">
                                    <TextBox Text="{Binding SelectedAction.WindowX, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_WindowX}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedAction.WindowY, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_WindowY}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowWindowDimensionFields}">
                                    <TextBox Text="{Binding SelectedAction.WindowWidth, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_WindowWidth}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding SelectedAction.WindowHeight, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_WindowHeight}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding ShowWindowTimeoutField}">
                                    <TextBox Text="{Binding SelectedAction.WindowTimeoutMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_WindowTimeout}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{localization:Loc Editor_DelayPlaceholder}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="12"/>
                                </Grid>
                                <TextBox Text="{Binding SelectedAction.WindowSelectorValue, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisible="{Binding ShowWindowAddressField}"
                                         PlaceholderText="{localization:Loc Editor_WindowAddress}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBox Text="{Binding SelectedAction.WindowWorkspace, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisible="{Binding ShowWindowWorkspaceField}"
                                         PlaceholderText="{localization:Loc Editor_WindowWorkspace}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBox Text="{Binding SelectedAction.WindowOutputVariable, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisible="{Binding ShowWindowOutputVariableField}"
                                         PlaceholderText="{localization:Loc Editor_WindowOutputVariable}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBlock Text="{localization:Loc Editor_WindowHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Variable Math (Increment / Decrement / Multiply / Divide) -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowIncDecFields}">
                                <TextBlock Text="{localization:Loc Editor_VariableUpdate}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ScriptVariableName, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_VariableNamePlaceholder}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                          SelectedItem="{Binding SelectedIncDecVariableSuggestion}"
                                          IsVisible="{Binding ShowIncDecVariablePicker}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"/>
                                <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                          SelectedItem="{Binding SelectedAction.ScriptNumericSourceType}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox Text="{Binding SelectedAction.ScriptNumericValue, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_AmountOrVariable}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <TextBlock Text="{localization:Loc Editor_IncrementDecrementHint}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Repeat -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowRepeatFields}">
                                <TextBlock Text="{localization:Loc Editor_RepeatBlock}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                          SelectedItem="{Binding SelectedAction.ScriptNumericSourceType}"
                                          IsVisible="{Binding ShowRepeatCountSimpleFields}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBox Text="{Binding SelectedAction.ScriptNumericValue, UpdateSourceTrigger=PropertyChanged}"
                                          IsVisible="{Binding ShowRepeatCountSimpleFields}"
                                          PlaceholderText="{localization:Loc Editor_CountOrVariable}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderThickness="0"
                                          CornerRadius="4"
                                          Padding="8,6"/>
                                <CheckBox IsChecked="{Binding IsRepeatCountAdvanced}"
                                           Content="{localization:Loc Editor_AdvancedArithmetic}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowRepeatCountAdvancedPanel}">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding RepeatCountExprLeftType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding RepeatCountExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_CountOrVariable}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                              SelectedItem="{Binding RepeatCountExprOperator}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding RepeatCountExprRightType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding RepeatCountExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedRepeatCountExprRightVariableSuggestion}"
                                              IsVisible="{Binding ShowRepeatCountExprRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- If / While condition -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowConditionFields}">
                                <TextBlock Text="{localization:Loc Editor_Condition}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{localization:Loc Editor_LeftOperand}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowConditionLeftSimpleFields}">
                                    <ComboBox ItemsSource="{Binding ScriptOperandTypes}"
                                              SelectedItem="{Binding SelectedAction.ScriptLeftOperandType}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="2" ColumnDefinitions="*,8,Auto" IsVisible="{Binding ShowConditionLeftOperandTextBox}">
                                        <TextBox Text="{Binding SelectedAction.ScriptLeftOperand, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_LeftValue}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <Button Grid.Column="2"
                                                Command="{Binding CaptureConditionLeftColorAsync}"
                                                Classes="primary compact"
                                                IsVisible="{Binding ShowConditionLeftColorPicker}"
                                                ToolTip.Tip="{localization:Loc Editor_CaptureTargetColor}"
                                                HorizontalContentAlignment="Center">
                                            <icons:EmojiAppIcon Icon="Location" Width="16" Height="16"/>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Command="{Binding CancelCapture}"
                                                Classes="danger compact"
                                                IsVisible="{Binding IsCapturingConditionLeftColor}"
                                                ToolTip.Tip="{localization:Loc Editor_CancelCapture}"
                                                HorizontalContentAlignment="Center">
                                            <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedConditionLeftVariableSuggestion}"
                                              IsVisible="{Binding ShowConditionLeftVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IsConditionLeftAdvanced}"
                                          Content="{localization:Loc Editor_AdvancedArithmetic}"
                                          IsVisible="{Binding ShowConditionLeftAdvancedToggle}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowConditionLeftAdvancedPanel}">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericOperandTypes}"
                                                  SelectedItem="{Binding ConditionLeftExprLeftType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ConditionLeftExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_LeftValue}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                              SelectedItem="{Binding ConditionLeftExprOperator}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericOperandTypes}"
                                                  SelectedItem="{Binding ConditionLeftExprRightType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ConditionLeftExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedConditionLeftExprRightVariableSuggestion}"
                                              IsVisible="{Binding ShowConditionLeftExprRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{localization:Loc Editor_Operator}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding ScriptConditionOperators}"
                                          SelectedItem="{Binding SelectedAction.ScriptConditionOperator}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ScriptConditionOperatorDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{localization:Loc Editor_RightOperand}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowConditionRightSimpleFields}">
                                    <ComboBox ItemsSource="{Binding ScriptOperandTypes}"
                                              SelectedItem="{Binding SelectedAction.ScriptRightOperandType}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="2" ColumnDefinitions="*,8,Auto" IsVisible="{Binding ShowConditionRightOperandTextBox}">
                                        <TextBox Text="{Binding SelectedAction.ScriptRightOperand, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_RightValue}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <Button Grid.Column="2"
                                                Command="{Binding CaptureConditionRightColorAsync}"
                                                Classes="primary compact"
                                                IsVisible="{Binding ShowConditionRightColorPicker}"
                                                ToolTip.Tip="{localization:Loc Editor_CaptureTargetColor}"
                                                HorizontalContentAlignment="Center">
                                            <icons:EmojiAppIcon Icon="Location" Width="16" Height="16"/>
                                        </Button>
                                        <Button Grid.Column="2"
                                                Command="{Binding CancelCapture}"
                                                Classes="danger compact"
                                                IsVisible="{Binding IsCapturingConditionRightColor}"
                                                ToolTip.Tip="{localization:Loc Editor_CancelCapture}"
                                                HorizontalContentAlignment="Center">
                                            <icons:EmojiAppIcon Icon="Cancel" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedConditionRightVariableSuggestion}"
                                              IsVisible="{Binding ShowConditionRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IsConditionRightAdvanced}"
                                          Content="{localization:Loc Editor_AdvancedArithmetic}"
                                          IsVisible="{Binding ShowConditionRightAdvancedToggle}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowConditionRightAdvancedPanel}">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericOperandTypes}"
                                                  SelectedItem="{Binding ConditionRightExprLeftType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ConditionRightExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_RightValue}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                              SelectedItem="{Binding ConditionRightExprOperator}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericOperandTypes}"
                                                  SelectedItem="{Binding ConditionRightExprRightType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ScriptOperandTypeDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ConditionRightExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedConditionRightExprRightVariableSuggestion}"
                                              IsVisible="{Binding ShowConditionRightExprRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConditionRightOperandHint}"
                                           IsVisible="{Binding ConditionRightOperandHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- For -->
                            <StackPanel Spacing="6" IsVisible="{Binding ShowForFields}">
                                <TextBlock Text="{localization:Loc Editor_ForBlock}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBox Text="{Binding SelectedAction.ForVariableName, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{localization:Loc Editor_LoopVariablePlaceholder}"
                                         Background="{DynamicResource SurfaceHoverBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderThickness="0"
                                         CornerRadius="4"
                                         Padding="8,6"/>
                                <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                          SelectedItem="{Binding SelectedForVariableSuggestion}"
                                          IsVisible="{Binding ShowForVariablePicker}"
                                          Background="{DynamicResource SurfaceHoverBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock Text="{localization:Loc Editor_Start}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowForStartSimpleFields}">
                                    <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                              SelectedItem="{Binding SelectedAction.ForStartType}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Grid.Column="2"
                                              Text="{Binding SelectedAction.ForStartValue, UpdateSourceTrigger=PropertyChanged}"
                                              PlaceholderText="{localization:Loc Editor_Start}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderThickness="0"
                                              CornerRadius="4"
                                              Padding="8,6"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IsForStartAdvanced}"
                                           Content="{localization:Loc Editor_AdvancedArithmetic}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowForStartAdvancedPanel}">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding ForStartExprLeftType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding ForStartExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_Start}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                              SelectedItem="{Binding ForStartExprOperator}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding ForStartExprRightType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding ForStartExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedForStartExprRightVariableSuggestion}"
                                              IsVisible="{Binding ShowForStartExprRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Text="{localization:Loc Editor_End}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowForEndSimpleFields}">
                                    <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                              SelectedItem="{Binding SelectedAction.ForEndType}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBox Grid.Column="2"
                                              Text="{Binding SelectedAction.ForEndValue, UpdateSourceTrigger=PropertyChanged}"
                                              PlaceholderText="{localization:Loc Editor_End}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderThickness="0"
                                              CornerRadius="4"
                                              Padding="8,6"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding IsForEndAdvanced}"
                                           Content="{localization:Loc Editor_AdvancedArithmetic}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Spacing="4" IsVisible="{Binding ShowForEndAdvancedPanel}">
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding ForEndExprLeftType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding ForEndExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_End}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                              SelectedItem="{Binding ForEndExprOperator}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding ForEndExprRightType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding ForEndExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                              SelectedItem="{Binding SelectedForEndExprRightVariableSuggestion}"
                                              IsVisible="{Binding ShowForEndExprRightVariablePicker}"
                                              Background="{DynamicResource SurfaceHoverBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding SelectedAction.ForHasStep}"
                                            Content="{localization:Loc Editor_UseExplicitStep}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowForStepFields}">
                                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding ShowForStepSimpleFields}">
                                        <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                  SelectedItem="{Binding SelectedAction.ForStepType}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Grid.Column="2"
                                                  Text="{Binding SelectedAction.ForStepValue, UpdateSourceTrigger=PropertyChanged}"
                                                  PlaceholderText="{localization:Loc Editor_Step}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  BorderThickness="0"
                                                  CornerRadius="4"
                                                  Padding="8,6"/>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding IsForStepAdvanced}"
                                               Content="{localization:Loc Editor_AdvancedArithmetic}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Spacing="4" IsVisible="{Binding ShowForStepAdvancedPanel}">
                                        <Grid ColumnDefinitions="*,8,*">
                                            <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                      SelectedItem="{Binding ForStepExprLeftType}"
                                                      Background="{DynamicResource SurfaceHoverBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBox Grid.Column="2"
                                                      Text="{Binding ForStepExprLeftValue, UpdateSourceTrigger=PropertyChanged}"
                                                      PlaceholderText="{localization:Loc Editor_Step}"
                                                      Background="{DynamicResource SurfaceHoverBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderThickness="0"
                                                      CornerRadius="4"
                                                      Padding="8,6"/>
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding ScriptArithmeticOperators}"
                                                  SelectedItem="{Binding ForStepExprOperator}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ScriptArithmeticOperationDisplayConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid ColumnDefinitions="*,8,*">
                                            <ComboBox ItemsSource="{Binding ScriptNumericSourceTypes}"
                                                      SelectedItem="{Binding ForStepExprRightType}"
                                                      Background="{DynamicResource SurfaceHoverBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBox Grid.Column="2"
                                                      Text="{Binding ForStepExprRightValue, UpdateSourceTrigger=PropertyChanged}"
                                                      PlaceholderText="{localization:Loc Editor_ExpressionRightOperand}"
                                                      Background="{DynamicResource SurfaceHoverBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderThickness="0"
                                                      CornerRadius="4"
                                                      Padding="8,6"/>
                                        </Grid>
                                        <ComboBox ItemsSource="{Binding AvailableVariableNames}"
                                                  SelectedItem="{Binding SelectedForStepExprRightVariableSuggestion}"
                                                  IsVisible="{Binding ShowForStepExprRightVariablePicker}"
                                                  Background="{DynamicResource SurfaceHoverBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{localization:Loc Editor_AdvancedArithmeticHint}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="12" IsVisible="{Binding ShowBatchDelayProperties}">
                            <TextBlock Text="{localization:Loc Editor_SelectedActionProperties}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,6">
                                <TextBlock Text="{Binding SelectedActionCount, StringFormat='{}{0} wait actions selected'}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel Spacing="4">
                                <CheckBox IsChecked="{Binding BatchDelayUseRandomDelay}"
                                          Content="{localization:Loc Editor_RandomizeDelay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowBatchFixedDelayInput}">
                                    <TextBlock Text="{localization:Loc Editor_DelayDuration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBox Text="{Binding BatchDelayDuration, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{localization:Loc Editor_DelayDurationPlaceholder}"
                                             Background="{DynamicResource SurfaceHoverBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             CornerRadius="4"
                                             Padding="8,6"/>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding ShowBatchRandomDelayOptions}">
                                    <TextBlock Text="{localization:Loc Editor_RandomDelayRangeMs}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,8,*">
                                        <TextBox Text="{Binding BatchRandomDelayMinMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Min}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding BatchRandomDelayMaxMs, Converter={StaticResource NullableIntConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{localization:Loc Editor_Max}"
                                                 Background="{DynamicResource SurfaceHoverBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0"
                                                 CornerRadius="4"
                                                 Padding="8,6"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- No Selection Message -->
                        <TextBlock Text="{localization:Loc Editor_SelectActionPrompt}"
                                   IsVisible="{Binding !HasSelectedActions}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"/>

                        <TextBlock Text="{Binding SelectedActionCount, StringFormat='{}{0} actions selected. Properties are shown only for one action or multiple wait actions.'}"
                                   IsVisible="{Binding ShowMultiSelectionPropertiesHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: Status + Actions -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <Border IsVisible="{Binding HasLoadWarnings}"
                        Background="{DynamicResource SurfaceHoverBrush}"
                        CornerRadius="6"
                        Padding="10,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{localization:Loc Editor_RestoreWarnings}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <ItemsControl ItemsSource="{Binding LoadWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <!-- Undo/Redo + Clear -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding Undo}"
                                Classes="secondary compact editor-toolbar-action"
                                IsEnabled="{Binding CanUndo}"
                                ToolTip.Tip="{localization:Loc Editor_UndoTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{icons:AppIcon Undo}" Classes="app-icon"/>
                                <TextBlock Text="{localization:Loc Editor_Undo}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Redo}"
                                Classes="secondary compact editor-toolbar-action"
                                IsEnabled="{Binding CanRedo}"
                                ToolTip.Tip="{localization:Loc Editor_RedoTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{icons:AppIcon Redo}" Classes="app-icon"/>
                                <TextBlock Text="{localization:Loc Editor_Redo}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearAll}"
                                Classes="danger compact editor-toolbar-action"
                                IsEnabled="{Binding HasActions}"
                                ToolTip.Tip="{localization:Loc Editor_ClearAllTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:EmojiAppIcon Icon="Delete" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Editor_Clear}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Save/Load -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ToggleTestPlaybackAsync}"
                                Classes="success compact"
                                Classes.danger="{Binding IsRunningTest}"
                                IsEnabled="{Binding HasActions}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:EmojiAppIcon Icon="{Binding RunIcon}" Width="16" Height="16"/>
                                <TextBlock Text="{Binding RunText}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding LoadMacroAsync}"
                                Classes="secondary compact">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:EmojiAppIcon Icon="FolderOpen" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Editor_Load}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveMacroAsync}"
                                Classes="primary compact"
                                IsEnabled="{Binding HasActions}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:EmojiAppIcon Icon="Save" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Editor_Save}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
