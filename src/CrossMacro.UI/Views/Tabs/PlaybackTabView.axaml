<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:CrossMacro.UI.Converters"
              xmlns:vm="using:CrossMacro.UI.ViewModels"
              xmlns:designVm="using:CrossMacro.UI.ViewModels.Design"
              xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="400"
             x:Class="CrossMacro.UI.Views.Tabs.PlaybackTabView"
             x:DataType="vm:PlaybackViewModel">

    <Design.DataContext>
        <designVm:DesignPlaybackViewModel/>
    </Design.DataContext>

    <Panel>
        <ScrollViewer Padding="10">
            <StackPanel Spacing="20">
                <!-- Speed Control -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="label" Text="{localization:Loc Playback_PlaybackSpeed}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PlaybackSpeed, StringFormat='{}{0:0.0}x'}"
                                  FontWeight="Medium"
                                  FontSize="16"
                                  Foreground="{DynamicResource PrimaryBrush}"/>
                    </Grid>
                    <Slider Minimum="0.1" Maximum="10.0" Value="{Binding PlaybackSpeed}"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding !IsPlaying}"/>
                </StackPanel>

                <!-- Motion fidelity -->
                <StackPanel Spacing="10">
                    <TextBlock Text="{localization:Loc Playback_MotionMode}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,24,*">
                            <RadioButton Grid.Column="0"
                                         GroupName="MotionMode"
                                         IsChecked="{Binding IsPrecisionMotionMode}"
                                         IsEnabled="{Binding !IsPlaying}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{localization:Loc Playback_MotionModePrecision}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{localization:Loc Playback_PrecisionMotionRateHint}"
                                               Classes="caption"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="2"
                                         GroupName="MotionMode"
                                         IsChecked="{Binding IsStrictSpeedMotionMode}"
                                         IsEnabled="{Binding !IsPlaying}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{localization:Loc Playback_MotionModeStrictSpeed}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{localization:Loc Playback_StrictSpeedMotionRateHint}"
                                               Classes="caption"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <Grid ColumnDefinitions="*,24,*">
                            <Grid Grid.Column="0"
                                  Margin="28,0,0,0"
                                  ColumnDefinitions="Auto,12,132,8,Auto"
                                  IsVisible="{Binding ShowPrecisionMotionRate}">
                                <TextBlock Classes="label"
                                           Text="{localization:Loc Playback_StrictSpeedMotionRate}"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="2"
                                               Width="132"
                                               Value="{Binding PrecisionMotionEventsPerSecond, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}"
                                               Minimum="60"
                                               Maximum="10000"
                                               Increment="50"
                                               FormatString="0"
                                               IsEnabled="{Binding !IsPlaying}"/>
                                <TextBlock Grid.Column="4"
                                           Text="/ s"
                                           Classes="caption"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Column="2"
                                  Margin="28,0,0,0"
                                  ColumnDefinitions="Auto,12,132,20,Auto,12,100,8,Auto"
                                  IsVisible="{Binding ShowStrictSpeedMotionRate}">
                                <TextBlock Classes="label"
                                           Text="{localization:Loc Playback_StrictSpeedMotionRate}"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="2"
                                               Width="132"
                                               Value="{Binding StrictSpeedMotionEventsPerSecond, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}"
                                               Minimum="60"
                                               Maximum="10000"
                                               Increment="100"
                                               FormatString="0"
                                               IsEnabled="{Binding !IsPlaying}"/>
                                <TextBlock Grid.Column="4"
                                           Classes="label"
                                           Text="{localization:Loc Playback_MaximumMotionPathError}"
                                           VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="6"
                                               Width="100"
                                               Value="{Binding MaximumMotionErrorPixels, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}"
                                               Minimum="0.25"
                                               Maximum="500"
                                               Increment="0.25"
                                               FormatString="0.##"
                                               IsEnabled="{Binding !IsPlaying}"/>
                                <TextBlock Grid.Column="8"
                                           Text="px"
                                           Classes="caption"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Loop Controls -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <CheckBox Grid.Row="0"
                                  Grid.Column="0"
                                  Content="{localization:Loc Playback_LoopPlayback}"
                                  IsChecked="{Binding IsLooping}"
                                  IsEnabled="{Binding !IsPlaying}"/>

                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Content="{localization:Loc Playback_RandomizeLoopDelay}"
                                  IsChecked="{Binding UseRandomLoopDelay}"
                                  IsEnabled="{Binding !IsPlaying}"
                                  IsVisible="{Binding IsLooping}"/>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Spacing="4"
                                    IsVisible="{Binding IsLooping}">
                            <TextBlock Classes="label" Text="{localization:Loc Playback_LoopCount}"/>
                            <NumericUpDown Value="{Binding LoopCount, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}" Minimum="0" Maximum="1000" FormatString="0" IsEnabled="{Binding !IsPlaying}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Spacing="4"
                                    IsVisible="{Binding ShowFixedLoopDelayInput}">
                            <TextBlock Classes="label" Text="{localization:Loc Playback_LoopDelayMs}"/>
                            <NumericUpDown Value="{Binding LoopDelayMs, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}" Minimum="0" Maximum="2147483647" Increment="100" FormatString="0" IsEnabled="{Binding !IsPlaying}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Spacing="4"
                                    IsVisible="{Binding ShowRandomLoopDelayInputs}">
                            <TextBlock Classes="label" Text="{localization:Loc Playback_LoopDelayRangeMs}"/>
                            <Grid ColumnDefinitions="*,8,*">
                                <NumericUpDown Value="{Binding LoopDelayMinMs, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}" Minimum="0" Maximum="2147483647" Increment="100" FormatString="0" IsEnabled="{Binding !IsPlaying}"/>
                                <NumericUpDown Grid.Column="2" Value="{Binding LoopDelayMaxMs, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}" Minimum="0" Maximum="2147483647" Increment="100" FormatString="0" IsEnabled="{Binding !IsPlaying}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Countdown -->
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{localization:Loc Playback_CountdownSec}"/>
                    <NumericUpDown Minimum="0" Maximum="2147483647" Value="{Binding CountdownSeconds, Converter={x:Static converters:NumericUpDownValueConverter.Instance}}"
                            Increment="1" FormatString="0" IsEnabled="{Binding !IsPlaying}"/>
                </StackPanel>

                <!-- Play Controls -->
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Grid.ColumnSpan="2"
                           Classes="primary"
                           Command="{Binding PlayMacroAsync}"
                           IsEnabled="{Binding CanPlayMacro}"
                           IsVisible="{Binding !IsPlaying}"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:EmojiAppIcon Icon="Play" Width="16" Height="16"/>
                            <TextBlock Text="{localization:Loc Playback_PlayMacro}"/>
                        </StackPanel>
                    </Button>

                     <Button Grid.Column="0" Grid.ColumnSpan="2"
                           Classes="danger"
                           Command="{Binding StopPlayback}"
                           IsVisible="{Binding IsPlaying}"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           FontWeight="Bold"
                           FontSize="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:EmojiAppIcon Icon="Stop" Width="16" Height="16"/>
                            <TextBlock Text="{localization:Loc Playback_StopPlayback}"/>
                        </StackPanel>
                     </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <icons:EmojiAppIcon Icon="Tip" Classes="caption-colored-icon"/>
                    <TextBlock Text="{localization:Loc Playback_LoopTip}" Classes="caption"/>
                </StackPanel>

                <!-- NEW: Bottom Spacer -->
                <Rectangle Height="40" Fill="Transparent"/>

            </StackPanel>
        </ScrollViewer>
    </Panel>

</UserControl>
